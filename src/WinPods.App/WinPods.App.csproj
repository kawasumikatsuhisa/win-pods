<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinPodsWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WinPodsSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinPods.App</RootNamespace>
    <AssemblyName>WinPods</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 単一 exe 配布を想定 (dotnet publish -c Release -r win-x64) -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <!-- .NET 8 デスクトップランタイムが無くても、より新しいランタイムで動かせるようにする -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinPods.Core\WinPods.Core.csproj" />
    <ProjectReference Include="..\WinPods.Windows\WinPods.Windows.csproj" />
  </ItemGroup>

</Project>
