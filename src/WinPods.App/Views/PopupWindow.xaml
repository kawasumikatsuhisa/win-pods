<Window x:Class="WinPods.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPods"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="BatteryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BatteryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>

    <Border Background="{StaticResource PopupBackgroundBrush}"
            BorderBrush="{StaticResource PopupBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <TextBlock Text="{Binding DeviceName}"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,2,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Visibility="{Binding HasSeparateEarpieces, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding LeftBatteryText}" Style="{StaticResource BatteryValueStyle}" />
                    <TextBlock Text="左" Style="{StaticResource BatteryLabelStyle}" />
                    <TextBlock Text="充電中"
                               Style="{StaticResource BatteryLabelStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding IsLeftCharging, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding RightBatteryText}" Style="{StaticResource BatteryValueStyle}" />
                    <TextBlock Text="右" Style="{StaticResource BatteryLabelStyle}" />
                    <TextBlock Text="充電中"
                               Style="{StaticResource BatteryLabelStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding IsRightCharging, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Visibility="{Binding HasCase, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding CaseBatteryText}" Style="{StaticResource BatteryValueStyle}" />
                    <TextBlock Text="ケース" Style="{StaticResource BatteryLabelStyle}" />
                    <TextBlock Text="充電中"
                               Style="{StaticResource BatteryLabelStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding IsCaseCharging, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>

            <Button Content="{Binding ConnectionActionText}"
                    Command="{Binding ToggleConnectionCommand}"
                    Margin="0,16,0,0"
                    Padding="0,8"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</Window>
